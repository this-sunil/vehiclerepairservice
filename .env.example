# Copy to .env and fill in for local development / live smoke tests.
# Never commit the real .env — it can contain private URLs and credentials.
BASE_URL="http://localhost:4000"
STORE_URL="https://res.cloudinary.com/your-cloud"

LOGIN="/api/login"
REGISTER="/api/register"
FETCH_PROFILE="/api/getProfile"
UPDATE_PROFILE="/api/updateProfile"
FETCH_CAT_API="/api/getAllCategory"
FETCH_SERVICE="/api/getAllService"
SEARCH_SERVICE="/api/searchService"
FETCH_SETTING="/api/fetchSetting"
BOOK_APPOINTMENT="/api/bookAppointment"
FETCH_SLOT_HISTORY="/api/bookingHistory"
SEARCH_BY_CITY="/api/searchByCity"
FETCH_PLAN="/api/fetchPlan"
FETCH_NOTIFICATION="/api/fetchNotification"
